

az aks get-credentials \
  --resource-group "app3tier-rg" \
  --name "app3tier-aks" \
  --overwrite-existing

# Verify connection and node status
kubectl get nodes




helm repo add ingress-nginx https://kubernetes.github.io/ingress-nginx
helm repo update

helm upgrade --install ingress-nginx ingress-nginx/ingress-nginx \
  --namespace ingress-nginx \
  --create-namespace \
  --set controller.service.annotations."service\.beta\.kubernetes\.io/azure-load-balancer-health-probe-request-path"=/healthz


cd three-tier-app

# Download and link subchart archives
helm dependency build


export TENANT_ID=$(az account show --query tenantId -o tsv)

# Deploy the parent Helm chart
helm upgrade --install three-tier-app . \
  --namespace default \
  --set global.azureWorkloadClientId="360cb7f4-7526-4ce8-ac34-4421800c0349" \
  --set global.azureTenantId="$TENANT_ID" \
  --set global.keyVaultName="app3tier-kv-cheap" \
  --wait \
  --timeout 10m


# 1. Verify the migration hook Job completed
kubectl get jobs -l app.kubernetes.io/component=migration

# 2. Check the synced Kubernetes Secret generated by CSI driver
kubectl get secret db-credentials-synced

# 3. Check all 3 tiers (Database StatefulSet, API Deployment, Frontend Deployment)
kubectl get pods -l app.kubernetes.io/instance=three-tier-app -o wide

# 4. Get the external Ingress Public IP
kubectl get ingress -n default


