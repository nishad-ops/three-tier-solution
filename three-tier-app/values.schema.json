{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ThreeTierValuesSchema",
  "type": "object",
  "required": ["global", "api", "database", "frontend"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["azureWorkloadClientId", "azureTenantId", "keyVaultName"],
      "properties": {
        "azureWorkloadClientId": { "type": "string" },
        "azureTenantId": { "type": "string" },
        "keyVaultName": { "type": "string" }
      }
    },
    "frontend": {
      "type": "object",
      "required": ["enabled", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "resources": { "$ref": "#/definitions/resourceLimits" }
      }
    },
    "api": {
      "type": "object",
      "required": ["enabled", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "resources": { "$ref": "#/definitions/resourceLimits" }
      }
    },
    "database": {
      "type": "object",
      "required": ["enabled", "resources", "persistence"],
      "properties": {
        "enabled": { "type": "boolean" },
        "resources": { "$ref": "#/definitions/resourceLimits" },
        "persistence": {
          "type": "object",
          "required": ["size", "storageClass"],
          "properties": {
            "size": { "type": "string" },
            "storageClass": { "type": "string" }
          }
        }
      }
    }
  },
  "definitions": {
    "resourceLimits": {
      "type": "object",
      "required": ["limits", "requests"],
      "properties": {
        "limits": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        },
        "requests": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        }
      }
    }
  }
}